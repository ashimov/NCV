---
# Example Ansible Vault Encrypted Secrets File
#
# This file should be encrypted with ansible-vault:
#   ansible-vault create group_vars/all/vault.yml --vault-password-file .vault_pass
#
# To edit:
#   ansible-vault edit group_vars/all/vault.yml --vault-password-file .vault_pass
#
# To view:
#   ansible-vault view group_vars/all/vault.yml --vault-password-file .vault_pass

# Consul gossip encryption key
# Generate with: consul keygen
# Or: openssl rand -base64 32
vault_consul_encrypt: ""

# Nomad Consul integration token
# Generate via Consul ACL after bootstrap
vault_nomad_consul_token: ""

# Vault Consul storage token
# Generate via Consul ACL after bootstrap
vault_vault_consul_token: ""

# Consul ACL tokens (optional)
vault_consul_acl_agent_token: ""
vault_consul_acl_default_token: ""
vault_consul_acl_replication_token: ""

# Nomad ACL tokens (if enabled)
vault_nomad_acl_token: ""

# Database passwords for jobs (examples)
vault_postgres_password: ""
vault_mysql_password: ""
vault_mongodb_password: ""

# Add your own secrets as needed
# vault_custom_secret: ""
