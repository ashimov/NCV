datacenter = "{{ consul_datacenter }}"
node_name = "{{ inventory_hostname }}"
data_dir = "{{ consul_data_dir }}"
bind_addr = "{{ consul_bind_addr }}"
advertise_addr = "{{ consul_advertise_addr }}"
client_addr = "{{ consul_client_addr }}"
server = {{ 'true' if consul_server else 'false' }}

{% if consul_server %}
bootstrap_expect = {{ consul_bootstrap_expect }}
{% endif %}

{% set consul_retry_join_effective = consul_retry_join %}
{% if consul_retry_join_cloud_enabled %}
{% set consul_retry_join_effective = consul_retry_join + consul_retry_join_cloud %}
{% endif %}
retry_join = {{ consul_retry_join_effective | unique | to_json }}

{% if consul_encrypt | length > 0 %}
encrypt = "{{ consul_encrypt }}"
{% endif %}

{% if consul_ui %}
ui_config {
  enabled = true
}
{% endif %}

{% if consul_connect_enabled %}
connect {
  enabled = true
}
{% endif %}

{% if consul_acl_enabled %}
acl {
  enabled = true
  default_policy = "{{ consul_acl_default_policy }}"
  down_policy = "{{ consul_acl_down_policy }}"
  enable_token_persistence = true
{% if consul_acl_agent_token | length > 0 or consul_acl_default_token | length > 0 or consul_acl_replication_token | length > 0 %}
  tokens {
{% if consul_acl_agent_token | length > 0 %}
    agent = "{{ consul_acl_agent_token }}"
{% endif %}
{% if consul_acl_default_token | length > 0 %}
    default = "{{ consul_acl_default_token }}"
{% endif %}
{% if consul_acl_replication_token | length > 0 %}
    replication = "{{ consul_acl_replication_token }}"
{% endif %}
  }
{% endif %}
}
{% endif %}

{% if consul_tls_enabled %}
tls {
  defaults {
    verify_incoming = true
    verify_outgoing = true
    verify_server_hostname = true
    ca_file = "{{ consul_tls_dir }}/ca.pem"
    cert_file = "{{ consul_tls_dir }}/cert.pem"
    key_file = "{{ consul_tls_dir }}/key.pem"
  }
}
{% endif %}
